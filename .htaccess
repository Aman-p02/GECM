# Default Index
DirectoryIndex index.php index.html

# Prevent direct access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# --------------------------------------------------------------
# CLEAN URL ENGINE (Pretty URLs for GEC Modasa)
# Seamlessly works on both Localhost (XAMPP) and Production
# --------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Prevent loop: if already rewritten internally, stop
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # 2. 301 Redirect: /index.php to / (root or subfolder, excludes admin areas and POST)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+index\.php([^\s]*) [NC]
    RewriteRule ^ %1/%2 [R=301,L,NE]

    # 2b. Redirect cached browser requests for /admin/about/* back to clean /admin/*
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+admin/about/([a-zA-Z0-9_\-]+) [NC]
    RewriteRule ^ %1/admin/%2 [R=302,L,NE]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+admin/about/?\s [NC]
    RewriteRule ^ %1/admin/principal-message [R=302,L,NE]

    # 3. 301 Redirect: Legacy root about URLs to /about/ (environment-agnostic)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|about)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+(overview|vision-mission|principal-message|facilities|e-newsletters|brochure|mandatory-disclosure|rankings|mou|idp)(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/about/%2 [R=301,L,NE,QSA]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|about)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+about-gecm(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/about/overview [R=301,L,NE,QSA]

    # 3c. 301 Redirect: Legacy root administration URLs to /administration/ (environment-agnostic)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|administration)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+(principal|council-of-heads|hostel-mess|committees)(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/administration/%2 [R=301,L,NE,QSA]

    # 3d. 301 Redirect: Legacy root academic URLs to /academics/ (environment-agnostic)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|academics)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+(courses|admission)(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/academics/%2 [R=301,L,NE,QSA]

    # 3e. 301 Redirect: Legacy root student corner URLs to /student-corner/ (environment-agnostic)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|student-corner)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+(student-section|student-rules|enrollment-details)(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/student-corner/%2 [R=301,L,NE,QSA]

    # 3f. 301 Redirect: Legacy root activities URLs to /activities/ (environment-agnostic)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/(admin|dept-admin|fac-admin|activities)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]*?)/+(college-activities|departmental-activities|faculty-activities)(?:\.php)?([?\s]) [NC]
    RewriteRule ^ %1/activities/%2 [R=301,L,NE,QSA]

    # 4. 301 Redirect: Direct .php requests to clean URL (excludes POST requests)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^.]+)\.php([^\s]*)\s [NC]
    RewriteRule ^ %1%2 [R=301,L,NE]

    # 4. Stop rewrite processing for existing files and directories (css, js, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Remove trailing slashes from non-directories (prevents broken relative assets)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?]+?)/+[?\s] [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ %1 [R=301,L,NE]

    # 6. Internal Rewrite: clean URL to matching .php file (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_\-\/]+)$ $1.php [L,QSA]
</IfModule>
